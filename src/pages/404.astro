---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { url } from "@/utils/url-utils";

// 404 的配图：从背景视频里抽的一帧（守岸人，第 8 秒），
// 由 ffmpeg 转成 WebP，见 public/assets/images/404-shorekeeper.webp
const illustration = "/assets/images/404-shorekeeper.webp";

// ══════════════════════════════════════════════════════════════
// 404 的文案与去处。想换一种说法，只改这一块就够了。
//
// 这一版让守岸人自己开口 —— 不是「页面不存在」的报错口吻，
// 而是她守在这里、发现你要找的东西不在了。
// ══════════════════════════════════════════════════════════════
const pageTitle = "我守在这里，但这一页不在";
const pageDesc = "潮水把它带走了。也可能，它从来没来过。";

// 三个去处。第一个是主按钮（实心），后两个是次要按钮（描边）
const actions = [
    { href: "/", icon: "material-symbols:waves", label: "回到岸上" },
    { href: "/archive/", icon: "material-symbols:library-books", label: "看看写过什么" },
    { href: "/gallery/", icon: "material-symbols:photo-library", label: "随便逛逛" },
];
---

<MainGridLayout title="404 · 页面未找到" description={pageDesc}>
    <div class="flex w-full rounded-(--radius-large) overflow-hidden relative">
        <div class="card-base z-10 relative w-full overflow-hidden">
            <!-- 配图 -->
            <div class="relative w-full overflow-hidden aspect-video max-h-[46vh]">
                <img
                    src={illustration}
                    alt=""
                    class="w-full h-full object-cover object-center"
                    loading="eager"
                    decoding="async"
                />
                <!-- 底部压暗一点，让下面的文字过渡自然 -->
                <div
                    class="absolute inset-0 pointer-events-none"
                    style="background:linear-gradient(to bottom, rgba(0,0,0,0) 55%, rgba(0,0,0,0.28) 100%)"
                >
                </div>
                <!-- 角落的 404 -->
                <div
                    class="absolute top-3 left-6 text-5xl md:text-6xl font-bold text-white/85 select-none pointer-events-none"
                    style="text-shadow:0 2px 10px rgba(0,0,0,0.5)"
                >
                    404
                </div>
            </div>

            <!-- 文案与去处 -->
            <div class="px-8 pt-9 pb-12 flex flex-col items-center text-center">
                <div class="text-3xl md:text-4xl font-bold mb-4 text-90">
                    {pageTitle}
                </div>

                <p class="text-lg text-75 mb-9 max-w-md">
                    {pageDesc}
                </p>

                <div class="flex flex-wrap items-center justify-center gap-3">
                    {
                        actions.map((a, i) => (
                            <a
                                href={url(a.href)}
                                class={`inline-flex items-center gap-2 px-6 py-3 rounded-(--radius-large) transition-colors duration-200 font-medium ${
                                    i === 0
                                        ? "btn-404-primary bg-(--primary) text-white hover:bg-(--btn-content)"
                                        : "btn-404-ghost text-90"
                                }`}
                            >
                                <Icon name={a.icon} class="text-xl" />
                                {a.label}
                            </a>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</MainGridLayout>

<style>
    .card-base {
        animation: fadeInUp 0.6s ease-out;
    }

    @keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* 次要按钮：用中性边框，避免和主按钮抢注意力 */
    .btn-404-ghost {
        border: 1px solid rgba(128, 128, 128, 0.35);
    }

    .btn-404-ghost:hover {
        background: rgba(128, 128, 128, 0.1);
    }

    /* 悬停时轻轻抬起。只作用于这一页自己的两个按钮，不影响站内其他链接 */
    .btn-404-primary,
    .btn-404-ghost {
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease,
            border-color 0.2s ease;
    }

    .btn-404-primary:hover,
    .btn-404-ghost:hover {
        transform: translateY(-2px);
    }

    @media (prefers-reduced-motion: reduce) {
        .card-base {
            animation: none;
        }

        .btn-404-primary:hover,
        .btn-404-ghost:hover {
            transform: none;
        }
    }
</style>
