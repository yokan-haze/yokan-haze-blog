---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 站长的设置保存后台（/admin/）
//
// 用途：把「我在本机设置面板里调好的样子」提交成全站默认值。
// 流程：读本机 localStorage 里主题的 15 个设置键 → 带上密码 POST /api/settings
//       → 接口写回仓库 → 自动重新构建 → 所有访客都变成这个样子。
//
// 安全：密码只保存在**你自己浏览器的 localStorage** 里，只随请求头发给本站的
// /api/settings，不写进代码、不进日志、也不经过任何第三方。
// 这个页面没有加进导航栏，也没有对外链接，并且带 noindex。
//
// 交互逻辑在 src/utils/admin-init.ts（initSettingsPage）：主题用 Swup 做软导航，
// 页面里的 is:inline 脚本软导航后不会重跑（站长反馈「不刷新就没用」），
// 所以逻辑统一放在 Layout 的打包脚本里，靠 astro:page-load 重新绑定。
// 设置键白名单也一并搬到了那个文件。
---

<MainGridLayout title="设置后台" description="把当前外观保存为全站默认。">
  <div class="card-base p-5 mb-4">
    <div class="text-2xl font-bold text-90 mb-1">设置保存后台</div>
    <div class="text-sm text-75">
      把「你现在看到的样子」保存成全站默认。保存后约 1 分钟生效，所有人打开都是这个样子。
    </div>
  </div>

  <div class="card-base p-5 mb-4">
    <div class="text-lg font-bold text-90 mb-2">第一步 · 输入保存密码</div>
    <div class="text-xs text-75 mb-3">
      就是 Cloudflare 环境变量 ADMIN_PASSWORD 里填的那个。只存在这台浏览器里。
    </div>
    <div class="flex gap-2 items-center flex-wrap">
      <input
        id="pw"
        type="password"
        placeholder="ADMIN_PASSWORD"
        class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm w-64"
      />
      <button id="savePw" class="btn-regular rounded-lg px-4 py-2 text-sm">记住密码</button>
      <span id="pwState" class="text-xs text-75"></span>
    </div>
  </div>

  <div class="card-base p-5 mb-4">
    <div class="text-lg font-bold text-90 mb-2">第二步 · 读取你现在的外观</div>
    <div class="text-xs text-75 mb-3">
      从这台浏览器的设置里读出当前值。没在设置面板调过的项不会出现。
    </div>
    <button id="read" class="btn-regular rounded-lg px-4 py-2 text-sm">读取本机设置</button>
    <div id="list" class="mt-3 text-sm"></div>
  </div>

  <div class="card-base p-5">
    <div class="text-lg font-bold text-90 mb-2">第三步 · 保存为全站默认</div>
    <div class="text-xs text-75 mb-3">
      提交到仓库并触发重新构建。构建期间站点仍可正常访问。
    </div>
    <button id="push" class="btn-regular rounded-lg px-4 py-2 text-sm">保存为全站默认</button>
    <div id="out" class="mt-3 text-sm"></div>
  </div>
</MainGridLayout>
