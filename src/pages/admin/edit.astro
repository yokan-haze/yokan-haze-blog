---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 文章编辑器（/admin/edit/）—— 站内后台第一轮
//
// 能做的事：写一篇新文章 / 编辑已有文章，点发布后由 /api/content 提交进仓库，
// 约 1 分钟后自动重新构建上线。
//
// 安全：密码复用 /admin/ 那套（同一个 localStorage 键），只发给本站接口。
//
// 交互逻辑在 src/utils/admin-init.ts（initEditPage）：主题用 Swup 做软导航，
// 页面里的 is:inline 脚本软导航后不会重跑（站长反馈「不刷新就没用」），
// 所以逻辑放在 Layout 的打包脚本里，靠 astro:page-load 重新绑定。
//
// 站长要求标题字号要大（像标题那样），正文加高：见下面 #title 的 1.6rem。

const TYPES = [
	{ key: "posts", label: "文章" },
	{ key: "dynamic", label: "动态（随笔）" },
	{ key: "projects", label: "项目" },
];
---

<MainGridLayout title="写文章" description="站内编辑">
  <div class="card-base p-5 mb-4">
    <div class="text-2xl font-bold text-90 mb-1">写文章</div>
    <div class="text-sm text-75">
      发布后约 1 分钟自动上线。密码和 <a href="/admin/" class="text-(--primary)">/admin/</a> 共用。
    </div>
  </div>

  <div class="card-base p-5 mb-4">
    <div class="grid gap-3">
      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-16">类型</label>
        <select id="type" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm">
          {TYPES.map((t) => <option value={t.key}>{t.label}</option>)}
        </select>
        <input
          id="filename"
          type="text"
          placeholder="文件名（留空自动生成；编辑旧文章时填原文件名）"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-64"
        />
      </div>

      <div id="loadState" class="text-xs text-75"></div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-16">标题</label>
        <input
          id="title"
          type="text"
          placeholder="文章标题"
          class="px-4 py-3 rounded-lg bg-(--btn-regular-bg) text-90 flex-1 font-bold"
          style="font-size: 1rem; line-height: 1.5;"
        />
      </div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-16">简介</label>
        <input id="description" type="text" placeholder="一句话简介（可选）" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 flex-1" style="font-size: 1rem;" />
      </div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-16">标签</label>
        <input id="tags" type="text" placeholder="用逗号分隔，例如：随笔, 建站" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1" />
      </div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-16">分类</label>
        <input id="category" type="text" placeholder="例如：随笔" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1" />
        <label class="text-sm text-75 flex items-center gap-1">
          <input id="draft" type="checkbox" />
          存为草稿
        </label>
        <label class="text-sm text-75 flex items-center gap-1">
          <input id="pinned" type="checkbox" />
          置顶（首页只放置顶的 4 篇）
        </label>
      </div>

      <!-- 封面：上传图片后点「用作封面」会把地址填到这里；也可以直接贴已有地址 -->
      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-16">封面</label>
        <input
          id="image"
          type="text"
          placeholder="/uploads/xxx.jpg（可留空）"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-64"
        />
        <button id="pickCover" type="button" class="btn-regular rounded-lg px-3 py-2 text-sm">上传封面图</button>
        <input id="coverFile" type="file" accept="image/*" class="hidden" />
      </div>

      <!-- 正文：先上传，再自动插入到光标处 -->
      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-16">插入</label>
        <button id="pickImage" type="button" class="btn-regular rounded-lg px-3 py-2 text-sm">上传图片</button>
        <button id="pickVideo" type="button" class="btn-regular rounded-lg px-3 py-2 text-sm">上传视频</button>
        <span class="text-xs text-50">图片 ≤ 30MB、视频 ≤ 40MB；原图原样上传、不压缩；上传会提交进仓库并触发一次构建（约 1 分钟）</span>
        <input id="imageFile" type="file" accept="image/*" class="hidden" />
        <input id="videoFile" type="file" accept="video/*" class="hidden" />
      </div>

      <div id="uploadState" class="text-xs text-75 leading-6"></div>

      <div class="flex gap-2 items-start">
        <label class="text-sm text-75 w-16 pt-2">正文</label>
        <div class="flex-1 min-w-0 flex flex-col gap-1" data-rt-editor>
          <!-- WPS 式：先选中一段文字，再点工具条（站长 2026-10-22 要求） -->
          <div class="rt-toolbar" data-rt-toolbar>
            <span class="rt-group">
              <span>字号</span>
              <select data-rt-size class="rt-select">
                  <option value="15">15</option>
                  <option value="16">16</option>
                  <option value="17">17</option>
                  <option value="18">18</option>
                  <option value="20">20</option>
                  <option value="22">22</option>
                  <option value="24">24</option>
                  <option value="28">28</option>
                  <option value="32">32</option>
              </select>
              <button type="button" data-rt-cmd="size" class="rt-btn">套用</button>
            </span>
            <span class="rt-group">
              <button type="button" data-rt-cmd="bold" class="rt-btn rt-btn-bold">B</button>
              <input type="color" data-rt-color value="#e11d48" class="rt-color" aria-label="文字颜色" />
              <button type="button" data-rt-cmd="clear" class="rt-btn">清格式</button>
            </span>
          </div>
          <div
            class="rt-canvas"
            data-rt-canvas
            tabindex="0"
            role="textbox"
            aria-multiline="true"
            aria-label="正文：可选中文字后用上方工具条改字号"
          ></div>
          <!-- 提交源：白板改完同步到这里；id 仍是 #body，后台逻辑不用改 -->
          <input type="hidden" id="body" data-body-source />
        </div>
      </div>

      <div class="flex gap-2 items-center flex-wrap pt-2">
        <input id="pw" type="password" placeholder="后台密码" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm w-56" />
        <button id="go" class="btn-regular rounded-lg px-5 py-2 text-sm">发布</button>
        <button id="reload" class="btn-regular rounded-lg px-4 py-2 text-sm">读取内容</button>
        <span id="out" class="text-sm"></span>
      </div>
    </div>
  </div>
</MainGridLayout>
