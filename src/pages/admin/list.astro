---
import MainGridLayout from "@/layouts/MainGridLayout.astro";

// 内容列表（/admin/list/）—— 站内后台第二轮
//
// 列出仓库里已有的内容，支持删除与跳到编辑器修改。
// 交互逻辑在 src/utils/admin-init.ts（initListPage）：逻辑放在 Layout 的打包脚本里，
// 软导航（Swup）换页后靠 astro:page-load 重新绑定，不用按 F5。
// 密码复用 /admin/ 那套 localStorage 键（adminPassword）。

const TYPES = [
	{ key: "posts", label: "文章" },
	{ key: "dynamic", label: "动态" },
	{ key: "projects", label: "项目" },
];
---

<MainGridLayout title="内容列表" description="站内管理">
  <div class="card-base p-5 mb-4">
    <div class="text-2xl font-bold text-90 mb-1">内容列表</div>
    <div class="text-sm text-75">
      点「删除」会真的从仓库删掉（Git 里有记录，能找回）；点「编辑」进编辑器改这一篇。
    </div>
  </div>

  <div class="card-base p-5">
    <div class="flex gap-2 items-center flex-wrap mb-4">
      <select id="type" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm">
        {TYPES.map((t) => <option value={t.key}>{t.label}</option>)}
      </select>
      <input id="pw" type="password" placeholder="后台密码" class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm w-56" />
      <button id="load" class="btn-regular rounded-lg px-4 py-2 text-sm">刷新列表</button>
      <span id="out" class="text-sm text-75"></span>
    </div>
    <div id="list" class="text-sm"></div>
  </div>
</MainGridLayout>
