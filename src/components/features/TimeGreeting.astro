---
import greetings from "@/data/greetings.json";

// 首页横幅副标题的「问候语」：按访客的本地时间挑一句，替他填进打字机。
//
// 为什么要放在浏览器里算：这是静态站，页面在构建时就定型了。
// 如果按构建时间算，问候语会永远停在构建那一刻 —— 早上打开也显示「已经很晚了哦」。
// 所以判断必须由访客的浏览器做。
//
// 为什么用 is:inline：内联脚本在解析到它时立即执行，**早于所有 defer 模块** ——
// 而主题的打字机（TypewriterText）是 defer 模块，它在初始化时读取 .typewriter 元素的
// data-text 属性。我们赶在它之前把 data-text 改成选中的那一句，打字机就会照常
// 把这句话一个字一个字打出来 —— 视觉与主题原本完全一致，没有任何额外动效。
// （若之后仍有二次初始化，见下方对 220ms 那次重初始化的处理。）

interface GreetingData {
	ownerName?: string;
	fallback?: string;
	birthday?: string;
	birthdayText?: string;
	time?: { from: number; to: number; text: string }[];
	weekendTime?: { from: number; to: number; text: string }[];
	fridayEveningFrom?: number;
	fridayEveningText?: string;
	dates?: Record<string, string>;
	lunar?: Record<string, string>;
}

const data = greetings as GreetingData;
---

<script is:inline define:vars={{ GREETINGS: data }}>
	(function () {
		if (window.__timeGreetingInit) return;
		window.__timeGreetingInit = true;

		var d = GREETINGS || {};

		function pad(n) {
			return (n < 10 ? "0" : "") + n;
		}

		// 把句子里的 {name} 换成站长名字。名字留空时，连它旁边的标点一起收干净，
		// 避免出现「早安，。今天也来了呢。」这种残句。
		function fill(text) {
			if (!text) return text;
			var name = (d.ownerName || "").trim();
			if (name) return text.replace(/\{name\}/g, name);
			return text
				.replace(/，\{name\}/g, "")
				.replace(/\{name\}，/g, "")
				.replace(/\{name\}/g, "");
		}

		// 在一个时段表里找当前该显示的那句
		function slotText(slots, h) {
			if (!slots) return null;
			for (var i = 0; i < slots.length; i++) {
				var s = slots[i];
				// from > to 表示跨零点（例如 22 -> 3）
				var hit = s.from <= s.to ? h >= s.from && h < s.to : h >= s.from || h < s.to;
				if (hit) return s.text;
			}
			return null;
		}

		// 按优先级挑一句；都没命中就返回 null（此时保留主题原本的副标题轮播）
		function pick(now) {
			var mmdd = pad(now.getMonth() + 1) + "-" + pad(now.getDate());
			var ymd = now.getFullYear() + "-" + mmdd;
			var h = now.getHours();
			var dow = now.getDay();

			// 1) 生日
			if (d.birthday && d.birthday === mmdd) {
				return fill(d.birthdayText || "生日快乐。今天你是主角。");
			}
			// 2) 农历节日（需要年份，逐年查表）
			if (d.lunar && d.lunar[ymd]) return fill(d.lunar[ymd]);
			// 3) 公历固定节日
			if (d.dates && d.dates[mmdd]) return fill(d.dates[mmdd]);
			// 4) 周五晚上
			if (dow === 5 && d.fridayEveningText && typeof d.fridayEveningFrom === "number" && h >= d.fridayEveningFrom) {
				return fill(d.fridayEveningText);
			}
			// 5) 时段。周六周日走 weekendTime，其余走 time。
			//    注意：这里**不能**用「一条周末文案盖住整天」——那样连着两天都是同一句话，
			//    看起来像坏掉了（真实发生过，站长以为问候语没生效）。
			var isWeekend = dow === 6 || dow === 0;
			var line = isWeekend ? slotText(d.weekendTime, h) : null;
			if (!line) line = slotText(d.time, h);
			return line ? fill(line) : null;
		}

		function apply() {
			var box = document.getElementById("banner-subtitle");
			if (!box) return;

			var line = pick(new Date());
			if (!line) return; // 没有命中：交给主题原本的副标题轮播

			var tw = box.querySelector(".typewriter");
			if (tw) {
				// 喂给打字机：写成只含这一句的 JSON 数组
				tw.setAttribute("data-text", JSON.stringify([line]));
				// 主题会在初始化后 220ms 再初始化一次（兼容 banner 显隐晚于内容替换），
				// 那一次就会读到我们改过的 data-text。
			} else {
				// 没开打字机时，主题用的是纯文本副标题
				box.textContent = line;
			}
		}

		// 首次：内联脚本执行时 #banner-subtitle 已在文档中，且早于打字机模块
		apply();

		// 二次保险：主题的打字机在 220ms 后会重初始化一次，那时再对齐一次
		setTimeout(apply, 260);

		// Swup 切页回来时 DOM 被替换，需要重新填一次
		["swup:contentReplaced", "swup:content:replace", "swup:page:view", "astro:page-load"].forEach(
			function (evt) {
				document.addEventListener(evt, function () {
					apply();
					setTimeout(apply, 260);
				});
			},
		);

		// ── 滚动时的显隐：一拉就隐藏，回到顶部才出现 ──
		// 覆盖透明模式下壁纸是固定铺满的，那行字也跟着"钉"在屏幕上，内容滚上来时会
		// 压在文字下面。所以只要有往下滚动的痕迹就收起来，只有回到顶部才让它回来。
		// 阈值取得很小（5px）：站长要的是「一拉就消失」，但又不能取 0 ——
		// 触控板/滚轮的细微回弹会让它在 0 和 1 之间抖动。
		var SCROLL_THRESHOLD = 5;
		var scrolling = false;

		function syncScrollState() {
			scrolling = false;
			var y = window.scrollY || document.documentElement.scrollTop || 0;
			document.documentElement.toggleAttribute("data-banner-text-hidden", y > SCROLL_THRESHOLD);
		}

		function onScroll() {
			if (scrolling) return;
			scrolling = true;
			// 用 rAF 合并高频滚动事件；再加一个 setTimeout 兜底 ——
			// rAF 在某些环境（例如无头浏览器的虚拟时间）会被挂起，
			// 有兜底才能保证状态最终一定会同步。两者都是幂等的，重复执行无害。
			requestAnimationFrame(syncScrollState);
			setTimeout(syncScrollState, 50);
		}

		window.addEventListener("scroll", onScroll, { passive: true });
		// Swup 切页后滚动位置会重置，同步一次
		document.addEventListener("swup:page:view", syncScrollState);
		syncScrollState();
		window.__bannerScrollInit = true; // 供测试探针确认监听已挂上
	})();
</script>

<style>
	/* 站名与问候语的淡入淡出。默认（在顶部）是可见的，往下滚过阈值后淡出。
	   transition 加在默认状态上，进出都有动画。时长取 0.25s —— 站长要的是
	   「一拉就消失」，太长的过渡会显得拖。 */
	:global(.banner-home-text-overlay) {
		transition: opacity 0.25s ease;
	}

	:global(html[data-banner-text-hidden] .banner-home-text-overlay) {
		opacity: 0 !important;
		pointer-events: none;
	}

	/* 尊重「减少动态效果」：直接切换，不做过渡 */
	@media (prefers-reduced-motion: reduce) {
		:global(.banner-home-text-overlay) {
			transition: none;
		}
	}
</style>
