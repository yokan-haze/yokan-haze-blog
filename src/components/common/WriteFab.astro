---
import { Icon } from "astro-icon/components";

// 写作入口浮动按钮
//
// 历史：2026-10-18 为「站上找不到发布入口」加的；最初是绿色胶囊 + 图标，
// 站长 2026-10-19 反馈：「不好看，换一个文雅点的名字，图标也要改，绿色的很难看很突兀」。
// 所以现在是**跟主题浮动控件同款的玻璃胶囊**（card-base 那套变量），
// 文字用正文色而不是主题色，只在 hover 时加深底色 —— 不再是绿块。
//
// 显隐：只在**首页**和**本子**（/notebook/ 及其分页）出现，其它页面一律看不到。
// 做法：这个元素永远渲染在 swup 容器之外（所以软导航不会把它换掉/丢掉），
// 首帧用 SSR 的 style 直接定生死（不会闪），切页后由 src/utils/write-fab.ts
// 监听 astro:page-load / swup:page:view 按当前地址重新校正。
// ⚠ 不能只在目标页面渲染这个元素：从文章页软导航回本子时，swup 只替换容器内容，
// 容器之外的元素不会被「补回来」—— 站长会遇到「本子里看不见落笔」。
interface Props {
	hidden?: boolean;
}
const { hidden = false } = Astro.props;
---
<a
  id="write-fab"
  href="/admin/edit/"
  aria-label="落笔：写一篇新文章"
  title="落笔 · 写一篇新文章"
  class="fixed z-40 flex items-center gap-2 rounded-full"
  style={hidden ? "display: none" : undefined}
  data-write-fab-boot={hidden ? "hidden" : "shown"}
>
  <Icon name="material-symbols:ink-pen" class="write-fab-icon text-[1.05rem]" aria-hidden="true" />
  <span class="write-fab-label text-sm font-medium tracking-wide">落笔</span>
</a>

<style>
  /* 位置：右下角，让开主题自带的浮动控件那一列（right:~1rem），留 30px 呼吸位 */
  #write-fab {
    right: 6.5rem;
    bottom: 6.5rem;
    padding: 0.6rem 1.05rem 0.6rem 0.9rem;
    /* 跟主题浮动控件一致的玻璃底 + 正文色文字。
       注意别用 --primary / --btn-content：那两个在这套主题里都是 hue 165 的绿，
       站长说「绿色很难看很突兀」，所以文字和图标一律走 --deep-text（深墨色）。 */
    background-color: var(--card-bg);
    color: var(--deep-text);
    border: 1px solid color-mix(in srgb, var(--deep-text) 12%, transparent);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.14);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  #write-fab:hover {
    background-color: var(--btn-card-bg-hover);
    border-color: color-mix(in srgb, var(--deep-text) 22%, transparent);
    box-shadow: 0 10px 28px rgb(0 0 0 / 0.18);
    transform: translateY(-1px);
  }

  #write-fab:active {
    transform: translateY(0);
  }

  #write-fab .write-fab-icon {
    opacity: 0.55;
    transition: opacity 0.2s ease;
  }

  #write-fab:hover .write-fab-icon {
    opacity: 0.8;
  }

  :global(html.dark) #write-fab {
    background-color: color-mix(in srgb, var(--card-bg) 80%, black);
  }

  #write-fab .write-fab-label {
    letter-spacing: 0.08em;
  }

  @media (max-width: 767px) {
    #write-fab {
      right: 4.5rem;
      bottom: 5.6rem;
      padding: 0.5rem 0.8rem 0.5rem 0.7rem;
      gap: 0.35rem;
    }

    #write-fab .write-fab-label {
      font-size: 0.75rem;
    }
  }
</style>
