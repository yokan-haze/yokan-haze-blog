---
// 文章详情页右下角的「编辑」按钮 —— 点了就地改这一篇，不跳页。
//
// 站长的原话：不要跳到 /admin/edit/ 去改，就在文章页面里改。
// 所以这里是一个悬浮按钮 + 就地弹层：读原文、改、保存，全程不离开这篇文章。
//
// 真正的写盘由 /api/content 完成（提交进 Git 仓库 → 自动构建 → 约 1 分钟后上线）。
// 交互逻辑在同目录的 src/utils/admin-init.ts 里（initPostInlineEditor）：
// 主题用 Swup 做软导航，写在这个组件里的 is:inline 脚本换页后不会重跑，
// 因此统一放到 Layout 的打包脚本里，靠 astro:page-load 重新绑定。
//
// 「保存」在读到原文之前是禁用的 —— 只有标题/正文都在手上时才允许写回，
// 避免出现「提交成功、但把文章写空了」这种最坏的静默事故。

interface Props {
	/** git 仓库里的相对路径，例如 src/content/posts/first.md */
	filePath: string;
	/** 文章标题，只用于按钮的提示文字 */
	title: string;
}

const { filePath, title } = Astro.props;
const filename = filePath.split("/").pop() ?? "";
---

<div id="post-edit-root" data-post-editor data-file-path={filePath}>
  <button
    id="post-edit-fab"
    type="button"
    class="post-edit-fab"
    data-file-path={filePath}
    data-filename={filename}
    title={`编辑《${title}》`}
    aria-label="编辑这篇文章"
  >
    <span class="post-edit-icon" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 20h9"></path>
        <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path>
      </svg>
    </span>
    <span class="post-edit-fab-label">编辑</span>
  </button>

  <div id="post-edit-backdrop" class="post-edit-backdrop hidden"></div>

  <div
    id="post-edit-panel"
    class="post-edit-panel card-base hidden"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="就地编辑这篇文章"
    tabindex="-1"
  >
    <div class="flex items-start justify-between gap-3 mb-2">
      <div class="min-w-0">
        <div class="text-lg font-bold text-90">就地编辑这一篇</div>
        <div class="text-xs text-50 mt-1 break-all">{filePath}</div>
      </div>
      <button id="pe-close" type="button" class="btn-regular rounded-lg px-3 py-1 text-sm shrink-0">关闭</button>
    </div>

    <div class="text-xs text-75 mb-3 leading-6">
      改完点「保存到仓库」，约 1 分钟后这一页更新。封面、置顶、评论开关、加密密码这些
      不会被这段表单改掉；原始版本都在 Git 里，能回退。
    </div>

    <div class="grid gap-3">
      <div class="flex gap-2 items-center">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-title">标题</label>
        <input
          id="pe-title"
          type="text"
          placeholder="文章标题"
          class="px-4 py-3 rounded-lg bg-(--btn-regular-bg) text-90 flex-1 font-bold min-w-0"
          style="font-size: 1.4rem; line-height: 1.3;"
        />
      </div>

      <div class="flex gap-2 items-center">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-description">简介</label>
        <input
          id="pe-description"
          type="text"
          placeholder="一句话简介（可留空）"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 flex-1 min-w-0"
        />
      </div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-tags">标签</label>
        <input
          id="pe-tags"
          type="text"
          placeholder="用逗号分隔，例如：随笔, 建站"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-0"
        />
      </div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-category">分类</label>
        <input
          id="pe-category"
          type="text"
          placeholder="例如：随笔"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-0"
        />
        <label class="text-sm text-75 flex items-center gap-1 shrink-0">
          <input id="pe-draft" type="checkbox" />
          存为草稿
        </label>
      </div>

      <div class="flex gap-2 items-start">
        <label class="text-sm text-75 w-14 shrink-0 pt-2" for="pe-body">正文</label>
        <textarea
          id="pe-body"
          rows="16"
          placeholder="正文用 Markdown 写。"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-0 font-mono leading-6"
        ></textarea>
      </div>

      <div class="flex gap-2 items-center flex-wrap pt-1">
        <input
          id="pe-pw"
          type="password"
          placeholder="后台密码"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm w-52"
        />
        <button id="pe-save" type="button" class="btn-regular rounded-lg px-5 py-2 text-sm" disabled>保存到仓库</button>
        <button id="pe-reload" type="button" class="btn-regular rounded-lg px-4 py-2 text-sm">读取原文</button>
      </div>

      <div id="pe-status" class="text-xs text-75 leading-6" aria-live="polite"></div>
    </div>
  </div>
</div>

<style>
  /* 悬浮按钮：右下角。要避开主题自带的那一列浮动控件（right 约 1rem、
     从 bottom 4rem 往上堆的圆形按钮），所以和「写文章」按钮一起往左让开一列，
     再叠在它上面一格。 */
  .post-edit-fab {
    position: fixed;
    z-index: 40;
    right: 5.5rem;
    bottom: 10.2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.62rem 1rem;
    border-radius: 9999px;
    background: var(--primary);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.28);
    transition: transform 0.2s ease;
  }

  .post-edit-fab:hover {
    color: #fff;
    transform: scale(1.05);
  }

  .post-edit-icon {
    display: flex;
  }

  .post-edit-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1200;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .post-edit-panel {
    position: fixed;
    z-index: 1210;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(94vw, 46rem);
    max-height: 88vh;
    overflow-y: auto;
    padding: 1.25rem;
    /* 编辑面板要看清字：在主题卡片底色上再压一层，不让壁纸透过来影响阅读 */
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
  }

  :global(html.dark) .post-edit-panel {
    background-color: rgba(23, 23, 23, 0.9);
  }

  @media (max-width: 767px) {
    .post-edit-fab {
      right: 4.5rem;
      bottom: 9.4rem;
      padding: 0.6rem 0.9rem;
    }

    /* 手机上保留文字：主题的「写文章」按钮是纯图标，两个都只剩铅笔会分不清 */
    .post-edit-fab-label {
      font-size: 0.8rem;
    }

    .post-edit-panel {
      width: 96vw;
      max-height: 92vh;
      padding: 1rem;
    }
  }
</style>
