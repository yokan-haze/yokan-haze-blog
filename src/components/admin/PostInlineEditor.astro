---
import FloatingButton from "@/components/common/FloatingButton.astro";

// 文章详情页右下角的「编辑」按钮 —— 点了就地改这一篇，不跳页。
//
// 站长的原话：不要跳到 /admin/edit/ 去改，就在文章页面里改。
// 所以这里是一个悬浮按钮 + 就地弹层：读原文、改、保存，全程不离开这篇文章。
//
// 站长 2026-10-18 晚追加：「把编辑改到和他们一起，这样更好看」——
// 也就是和主题自带的那一列浮动控件（目录 / 评论 / 回到顶部）同款、同一列。
// 所以按钮不再是绿色胶囊，而是直接复用 <FloatingButton>（同样的 3rem 圆角玻璃块、
// 同样的主题色图标）；位置由 admin-init.ts 在初始化时把整个节点插进
// .floating-controls-container 的第一位（那一列是 flex column、右对齐、自动堆叠）。
//
// 真正的写盘由 /api/content 完成（提交进 Git 仓库 → 自动构建 → 约 1 分钟后上线）。
// 交互逻辑在 src/utils/admin-init.ts 里（initPostInlineEditor）：
// 主题用 Swup 做软导航，写在这个组件里的 is:inline 脚本换页后不会重跑，
// 因此统一放到 Layout 的打包脚本里，靠 astro:page-load 重新绑定。
//
// 「保存」在读到原文之前是禁用的 —— 只有标题/正文都在手上时才允许写回，
// 避免出现「提交成功、但把文章写空了」这种最坏的静默事故。

interface Props {
	/** git 仓库里的相对路径，例如 src/content/posts/first.md */
	filePath: string;
	/** 文章标题，只用于按钮的提示文字 */
	title: string;
}

const { filePath, title } = Astro.props;
const filename = filePath.split("/").pop() ?? "";
const tip = `编辑《${title}》`;
---

<div id="post-edit-root" data-post-editor data-file-path={filePath}>
  <div id="post-edit-fab" class="post-edit-fab" data-file-path={filePath} data-filename={filename}>
    <FloatingButton
      id="post-edit-fab-btn"
      icon="material-symbols:edit-rounded"
      title={tip}
      ariaLabel="编辑这篇文章"
    />
  </div>

  <div id="post-edit-backdrop" class="post-edit-backdrop hidden"></div>

  <div
    id="post-edit-panel"
    class="post-edit-panel card-base hidden"
    role="dialog"
    aria-modal="true"
    aria-hidden="true"
    aria-label="就地编辑这篇文章"
    tabindex="-1"
  >
    <div class="flex items-start justify-between gap-3 mb-2">
      <div class="min-w-0">
        <div class="text-lg font-bold text-90">就地编辑这一篇</div>
        <div class="text-xs text-50 mt-1 break-all">{filePath}</div>
      </div>
      <button id="pe-close" type="button" class="btn-regular rounded-lg px-3 py-1 text-sm shrink-0">关闭</button>
    </div>

    <div class="text-xs text-75 mb-3 leading-6">
      改完点「保存到仓库」，约 1 分钟后这一页更新。置顶、封面、上传图片/视频都在这里；
      评论开关、加密密码这些不会被这段表单改掉，原始版本都在 Git 里，能回退。
    </div>

    <div class="grid gap-3">
      <div class="flex gap-2 items-center">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-title">标题</label>
        <input
          id="pe-title"
          type="text"
          placeholder="文章标题"
          class="px-4 py-3 rounded-lg bg-(--btn-regular-bg) text-90 flex-1 font-bold min-w-0"
          style="font-size: 1rem; line-height: 1.5;"
        />
      </div>

      <div class="flex gap-2 items-center">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-description">简介</label>
        <input
          id="pe-description"
          type="text"
          placeholder="一句话简介（可留空）"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 flex-1 min-w-0"
        />
      </div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-tags">标签</label>
        <input
          id="pe-tags"
          type="text"
          placeholder="用逗号分隔，例如：随笔, 建站"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-0"
        />
      </div>

      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-category">分类</label>
        <input
          id="pe-category"
          type="text"
          placeholder="例如：随笔"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-0"
        />
        <label class="text-sm text-75 flex items-center gap-1 shrink-0">
          <input id="pe-draft" type="checkbox" />
          存为草稿
        </label>
        <label class="text-sm text-75 flex items-center gap-1 shrink-0">
          <input id="pe-pinned" type="checkbox" />
          置顶
        </label>
      </div>

      <!-- 封面：和「落笔」那页一样，能换图（站长 2026-10-19 反馈「编辑时没有封面」） -->
      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-14 shrink-0" for="pe-image">封面</label>
        <input
          id="pe-image"
          type="text"
          placeholder="/uploads/xxx.jpg（可留空）"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm flex-1 min-w-0"
        />
        <button id="pe-pickCover" type="button" class="btn-regular rounded-lg px-3 py-1.5 text-sm">上传封面图</button>
        <input id="pe-coverFile" type="file" accept="image/*" class="hidden" />
      </div>

      <!-- 正文插入：和「落笔」那页一样，上传后插到光标处 -->
      <div class="flex gap-2 items-center flex-wrap">
        <label class="text-sm text-75 w-14 shrink-0">插入</label>
        <button id="pe-pickImage" type="button" class="btn-regular rounded-lg px-3 py-1.5 text-sm">上传图片</button>
        <button id="pe-pickVideo" type="button" class="btn-regular rounded-lg px-3 py-1.5 text-sm">上传视频</button>
        <span class="text-[0.7rem] text-50">图片 ≤ 30MB、视频 ≤ 40MB；原图原样上传、不压缩</span>
        <input id="pe-imageFile" type="file" accept="image/*" class="hidden" />
        <input id="pe-videoFile" type="file" accept="video/*" class="hidden" />
      </div>

      <div id="pe-uploadState" class="text-xs text-75 leading-6" aria-live="polite"></div>

      <div class="flex gap-2 items-start">
        <label class="text-sm text-75 w-14 shrink-0 pt-2" for="pe-body">正文</label>
        <div class="flex-1 min-w-0 flex flex-col gap-1" data-rt-editor>
          <!-- WPS 式：先选中一段文字，再点工具条（站长 2026-10-22 要求） -->
          <div class="rt-toolbar" data-rt-toolbar>
            <span class="rt-group">
              <span>字号</span>
              <select data-rt-size class="rt-select">
                  <option value="15">15</option>
                  <option value="16">16</option>
                  <option value="17">17</option>
                  <option value="18">18</option>
                  <option value="20">20</option>
                  <option value="22">22</option>
                  <option value="24">24</option>
                  <option value="28">28</option>
                  <option value="32">32</option>
              </select>
              <button type="button" data-rt-cmd="size" class="rt-btn">套用</button>
            </span>
            <span class="rt-group">
              <button type="button" data-rt-cmd="bold" class="rt-btn rt-btn-bold">B</button>
              <input type="color" data-rt-color value="#e11d48" class="rt-color" aria-label="文字颜色" />
              <button type="button" data-rt-cmd="clear" class="rt-btn">清格式</button>
            </span>
          </div>
          <div
            class="rt-canvas"
            data-rt-canvas
            tabindex="0"
            role="textbox"
            aria-multiline="true"
            aria-label="正文：可选中文字后用上方工具条改字号"
          ></div>
          <!-- 提交源：白板改完同步到这里；id 仍是 #pe-body -->
          <input type="hidden" id="pe-body" data-body-source />
        </div>
      </div>

      <div class="flex gap-2 items-center flex-wrap pt-1">
        <input
          id="pe-pw"
          type="password"
          placeholder="后台密码"
          class="px-3 py-2 rounded-lg bg-(--btn-regular-bg) text-90 text-sm w-52"
        />
        <button id="pe-save" type="button" class="btn-regular rounded-lg px-5 py-2 text-sm" disabled>保存到仓库</button>
        <button id="pe-reload" type="button" class="btn-regular rounded-lg px-4 py-2 text-sm">读取原文</button>
      </div>

      <div id="pe-status" class="text-xs text-75 leading-6" aria-live="polite"></div>
    </div>
  </div>
</div>

<style>
  /* 按钮本体是主题的 <FloatingButton>（3rem 圆角玻璃块、主题色图标），
     和目录/评论/回到顶部那一列完全同款；位置由 admin-init.ts 把整个节点
     插进 .floating-controls-container 的第一位，间距/右对齐/响应式全部跟那一列走。
     这里只需要保证包裹层不撑出额外的宽高。 */
  .post-edit-fab {
    display: block;
    line-height: 0;
  }

  /* 面板与遮罩是 position: fixed，不参与那一列的 flex 布局；
     但 pointer-events 会从 .floating-controls-container 继承 none，必须显式收回来。 */
  .post-edit-backdrop {
    position: fixed;
    inset: 0;
    z-index: 1200;
    pointer-events: auto;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .post-edit-panel {
    position: fixed;
    z-index: 1210;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: min(94vw, 46rem);
    max-height: 88vh;
    overflow-y: auto;
    padding: 1.25rem;
    pointer-events: auto;
    /* 编辑面板要看清字：在主题卡片底色上再压一层，不让壁纸透过来影响阅读 */
    background-color: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(14px) saturate(1.15);
    -webkit-backdrop-filter: blur(14px) saturate(1.15);
  }

  :global(html.dark) .post-edit-panel {
    background-color: rgba(23, 23, 23, 0.9);
  }

  @media (max-width: 767px) {
    .post-edit-panel {
      width: 96vw;
      max-height: 92vh;
      padding: 1rem;
    }
  }
</style>
